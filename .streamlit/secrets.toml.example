# Скопируйте этот файл как secrets.toml и задайте свои логин и пароль.
# Файл secrets.toml не попадает в git.

[credentials]
admin = "замените_пароль"

# Чтобы каталог материалов в Streamlit Cloud переживал перезапуск,
# добавьте те же строки в Secrets приложения на share.streamlit.io.
# Токен: GitHub → Settings → Developer settings → Personal access tokens
# (Fine-grained: Contents read/write к репозиторию vsp-price).
[github]
token = "github_pat_замените"
repo = "stimpyreal-creator/vsp-price"
branch = "main"
